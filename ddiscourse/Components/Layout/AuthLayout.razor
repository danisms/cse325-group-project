@inherits LayoutComponentBase

@* No sidebar or tab bar on Sign in / Create account (see app.css section 10).
   On those pages add:  @layout AuthLayout
   and render <div class="card auth-card"> with the .auth-tabs inside it. *@
<div class="auth">
    <a class="brand" href=""><img src="logo.png" alt="" />Discourse</a>
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" role="button" aria-label="Dismiss">✕</span>
</div>
